prefix  = "PREFIX"
region  = "us-east-1"
vpc_id  = "vpc-12345"
subnet  = "subnet-12345"
tags    = { "Deployment" = "PREFIX" }

# From the rds-cluster deployment (rds_security_group and the admin login secret ARN are rds-cluster outputs)
rds_endpoint              = "PREFIX-rds-cluster-v2.cluster-12345.us-east-1.rds.amazonaws.com"
rds_security_group        = "sg-12345"
admin_db_login_secret_arn = "arn:aws:secretsmanager:us-east-1:<account ID>:secret:PREFIX-db-login-admin-XXXXXX"
pg_db                     = "postgres"
pg_schema                 = "public"

# The bucket is created by the bootstrap task if it does not exist, so the name must be globally unique
iceberg_namespace = "PREFIX"
iceberg_s3_bucket = "PREFIX-iceberg"

kafka_image           = "<account ID>.dkr.ecr.us-east-1.amazonaws.com/cumulus/debezium/kafka:3.4"
connect_image         = "<account ID>.dkr.ecr.us-east-1.amazonaws.com/cumulus/debezium/connect:3.4"
bootstrap_image       = "<account ID>.dkr.ecr.us-east-1.amazonaws.com/cumulus/replication-bootstrap:TAG"
iceberg_cleanup_image = "<account ID>.dkr.ecr.us-east-1.amazonaws.com/cumulus/replication-bootstrap:TAG"
